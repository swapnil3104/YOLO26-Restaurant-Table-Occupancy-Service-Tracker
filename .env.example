# ==============================================================================
# SmartServe AI - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your environment configuration.
# DO NOT commit real secrets, private stream URLs, or production credentials.
# ==============================================================================

# Application & Server
APP_ENV=development
APP_NAME=SmartServe AI
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
ALLOWED_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (PostgreSQL / SQLite prototype)
# For local dev / testing, SQLite can be used: sqlite+aiosqlite:///./smartserve.db
# For production/staging: postgresql+asyncpg://user:password@localhost:5432/smartserve
DATABASE_URL=sqlite+aiosqlite:///./smartserve.db
DATABASE_ECHO=false

# Computer Vision & Video Ingestion
# Source can be an integer webcam index (e.g. 0), local video file path, or RTSP/HTTP URL
DEFAULT_CAMERA_ID=CAM-01
DEFAULT_CAMERA_SOURCE=0
CAMERA_RECONNECT_MAX_ATTEMPTS=5
CAMERA_RECONNECT_INITIAL_DELAY_SEC=1.0
CAMERA_HEALTH_CHECK_INTERVAL_SEC=5.0
FRAME_SAMPLE_RATE_HZ=5.0
INFERENCE_FRAME_WIDTH=1280
INFERENCE_FRAME_HEIGHT=720

# Model & Tracking Configuration
# Detector provider: ultralytics (supports YOLO11/YOLOv8/custom weights)
DETECTOR_PROVIDER=ultralytics
MODEL_WEIGHTS_PATH=yolo11n.pt
DETECTION_CONFIDENCE_THRESHOLD=0.45
DETECTION_CLASSES=["person"]
TRACKER_TYPE=bytetrack
TRACKER_MAX_AGE_FRAMES=30

# Table Occupancy & Business Rules
# Temporal persistence window to confirm occupied status (seconds)
OCCUPANCY_PERSISTENCE_TIME_SEC=5.0
# Vacancy grace duration to handle brief guest departure before session close (seconds)
VACANCY_GRACE_SEC=180.0
# Tracker occlusion tolerance before track loss (seconds)
TRACKER_OCCLUSION_GRACE_SEC=3.0

# Service Timer Thresholds (seconds)
THRESHOLD_FIRST_ATTENDANCE_SEC=300.0       # 5 minutes
THRESHOLD_FOOD_DELIVERY_SEC=1200.0         # 20 minutes
THRESHOLD_TABLE_OCCUPANCY_MAX_SEC=7200.0   # 2 hours

# Data Retention & Privacy
EVENT_RETENTION_DAYS=90
RAW_VIDEO_RETENTION_DAYS=0                 # 0 = do not persist continuous raw video
ANONYMIZE_EXPORTS=true
